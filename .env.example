# Copy to .env and fill in. `npm run dev` and `docker compose` both read it.

# Signs login cookies. Required in production (docker compose will not
# start without it); in development a built-in insecure secret is used
# when it is blank. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Set to "true" when served over HTTPS, so the login cookie is sent only
# over secure connections.
COOKIE_SECURE=false

# Port the server listens on (with docker compose: the port on your machine).
PORT=3000

# Optional, shown with their defaults. Docker sets its own values
# (HOST=0.0.0.0, DB_PATH=/data/kanban.db, WEB_DIST_DIR=/app/apps/web/dist).
# HOST=127.0.0.1
# DB_PATH=./data/kanban.db          (relative to apps/server)
# WEB_DIST_DIR=                     (serve a built web app, e.g. ../web/dist)
